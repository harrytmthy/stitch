# Build Time Benchmark: Per-sample clean builds
#
# Usage (run from project root with ANDROID_HOME set, on JDK 21 or newer):
#   export ANDROID_HOME=/Users/harry.tumalewa/Library/Android/sdk
#
#   # Run all scenarios:
#   /opt/homebrew/bin/gradle-profiler --benchmark --scenario-file build-time-benchmark.scenarios

clean_build_none {
    title = "Clean Build (none)"
    tasks = [":sample:none:assembleDebug"]
    cleanup-tasks = [":sample:shared:clean", ":sample:none:clean"]
    clear-project-cache-before = SCENARIO
    clear-transform-cache-before = SCENARIO
    gradle-args = ["--no-build-cache", "--no-configuration-cache", "-Pfixture=200", "-PexcludeOtherModules=true"]
    warm-ups = 12
    iterations = 10
}

